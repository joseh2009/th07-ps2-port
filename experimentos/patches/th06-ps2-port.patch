diff --git a/src/graphics/PS2GS.cpp b/src/graphics/PS2GS.cpp
new file mode 100644
index 0000000..c6410f8
--- /dev/null
+++ b/src/graphics/PS2GS.cpp
@@ -0,0 +1,807 @@
+#include "PS2GS.hpp"
+
+#include "AnmManager.hpp"
+#include "GameWindow.hpp"
+#include "Supervisor.hpp"
+#include "utils.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#include <dmaKit.h>
+#include <gsInline.h>
+#include <gsToolkit.h>
+#include <kernel.h>
+#include <malloc.h>
+
+// Framebuffer depth. 16 bit (with dithering) leaves ~1.2 MB more VRAM for textures than 32 bit.
+// Build with -DTH06_PS2_CT32 to get a 32 bit framebuffer instead.
+#ifdef TH06_PS2_CT32
+#define TH06_FB_PSM GS_PSM_CT32
+#else
+#define TH06_FB_PSM GS_PSM_CT16
+#endif
+
+// Everything is uploaded as RGBA32 (alpha scaled to the GS range 0..128)
+#define TH06_TEX_PSM GS_PSM_CT32
+
+namespace
+{
+constexpr int kMaxBatchVerts = 3 * 256;
+constexpr f32 kNearW = 0.001f;   // w below this is treated as behind the camera
+constexpr f32 kGuardBand = 4.0f; // clip |x|,|y| to 4*w so coordinates stay inside the GS primitive range
+constexpr int kMinTexSize = 8;   // the GS upload path needs at least 8x8 texels
+
+inline u8 ZunA(ZunColor c)
+{
+    return (u8)(c >> 24);
+}
+inline u8 ZunR(ZunColor c)
+{
+    return (u8)(c >> 16);
+}
+inline u8 ZunG(ZunColor c)
+{
+    return (u8)(c >> 8);
+}
+inline u8 ZunB(ZunColor c)
+{
+    return (u8)c;
+}
+
+// 0..255 (D3D) -> 0..128 (GS, where 128 == 1.0)
+inline u8 ToGS(f32 v255)
+{
+    int v = (int)(v255 * 0.5f + 0.5f);
+    return (u8)(v < 0 ? 0 : (v > 128 ? 128 : v));
+}
+
+inline u32 PackGS(u32 r, u32 g, u32 b, u32 a8)
+{
+    u32 a = (a8 + 1) >> 1; // 0..255 -> 0..128
+    return r | (g << 8) | (b << 16) | (a << 24);
+}
+
+// Expand a `bits` wide channel to 8 bits, replicating the high bits so the maximum maps to 255
+inline u32 Expand(u32 v, u32 bits)
+{
+    switch (bits)
+    {
+    case 1:
+        return v ? 255 : 0;
+    case 4:
+        return (v << 4) | v;
+    case 5:
+        return (v << 3) | (v >> 2);
+    default: // 6
+        return (v << 2) | (v >> 4);
+    }
+}
+
+inline bool IsIdentity(const ZunMatrix &m)
+{
+    for (int i = 0; i < 4; i++)
+        for (int j = 0; j < 4; j++)
+            if (m.m[i][j] != (i == j ? 1.0f : 0.0f))
+                return false;
+    return true;
+}
+
+// Signed distance to each of the 5 clip planes (>= 0 means inside)
+inline f32 PlaneDist(int plane, f32 x, f32 y, f32 w)
+{
+    switch (plane)
+    {
+    case 0:
+        return w - kNearW;
+    case 1:
+        return kGuardBand * w - x;
+    case 2:
+        return kGuardBand * w + x;
+    case 3:
+        return kGuardBand * w - y;
+    default:
+        return kGuardBand * w + y;
+    }
+}
+
+inline u32 OutCode(f32 x, f32 y, f32 w)
+{
+    u32 code = 0;
+    for (int p = 0; p < 5; p++)
+        if (PlaneDist(p, x, y, w) < 0.0f)
+            code |= 1u << p;
+    return code;
+}
+} // namespace
+
+// ------------------------------------------------------------------------------------------------
+// Init / Exit
+// ------------------------------------------------------------------------------------------------
+
+GfxInterface *PS2GS::Init()
+{
+    PS2GS *self = new PS2GS;
+
+    self->model.Identity();
+    self->view.Identity();
+    self->projection.Identity();
+    self->textureMatrix.Identity();
+    self->noVertexBuffer = g_Supervisor.cfg.opts & (1 << GCOS_DONT_USE_VERTEX_BUF);
+    self->textures.emplace_back(); // reserve handle 0
+
+    GSGLOBAL *gs = gsKit_init_global_custom(1536 * 1024, 128 * 1024);
+    if (gs == nullptr)
+    {
+        delete self;
+        return nullptr;
+    }
+    self->gs = gs;
+
+    gs->Mode = gsKit_check_rom();
+    gs->Interlace = GS_INTERLACED;
+    gs->Field = GS_FIELD;
+    gs->Width = 640;
+    gs->Height = (gs->Mode == GS_MODE_PAL) ? 512 : 448;
+    gs->PSM = TH06_FB_PSM;
+    gs->PSMZ = GS_PSMZ_16S;
+    gs->ZBuffering = GS_SETTING_ON;
+    gs->DoubleBuffering = GS_SETTING_ON;
+    gs->PrimAlphaEnable = GS_SETTING_ON;
+    gs->Dithering = GS_SETTING_ON;
+
+    dmaKit_init(D_CTRL_RELE_OFF, D_CTRL_MFD_OFF, D_CTRL_STS_UNSPEC, D_CTRL_STD_OFF, D_CTRL_RCYC_8, 1 << DMA_CHANNEL_GIF);
+    dmaKit_chan_init(DMA_CHANNEL_GIF);
+
+    gsKit_set_clamp(gs, GS_CMODE_REPEAT);
+    gsKit_vram_clear(gs);
+    gsKit_init_screen(gs);
+    gsKit_TexManager_init(gs);
+    gsKit_mode_switch(gs, GS_ONESHOT);
+
+    self->scaleX = (f32)gs->Width / GAME_WINDOW_WIDTH;
+    self->scaleY = (f32)gs->Height / GAME_WINDOW_HEIGHT;
+
+    // gsKit_vram_clear() does not touch the physical VRAM: clear and flip both buffers
+    for (int i = 0; i < 2; i++)
+    {
+        gsKit_clear(gs, GS_SETREG_RGBAQ(0, 0, 0, 0x80, 0));
+        gsKit_queue_exec(gs);
+        gsKit_finish();
+        gsKit_sync_flip(gs);
+    }
+
+    self->clipVerts.reserve(1024);
+    self->texBatch.reserve(kMaxBatchVerts);
+    self->flatBatch.reserve(kMaxBatchVerts);
+
+    utils::DebugPrint2("PS2 GS backend: %dx%d %s, %s framebuffer + 16 bit Z", (int)gs->Width, (int)gs->Height,
+                       gs->Mode == GS_MODE_PAL ? "PAL" : "NTSC", TH06_FB_PSM == GS_PSM_CT32 ? "32 bit" : "16 bit");
+    return self;
+}
+
+PS2GS::~PS2GS()
+{
+    for (Tex &t : textures)
+        ReleaseTextureMemory(&t);
+    if (gs)
+    {
+        gsKit_vram_clear(gs);
+        gsKit_deinit_global(gs);
+        gs = nullptr;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// Simple state setters
+// ------------------------------------------------------------------------------------------------
+
+void PS2GS::SetFogRange(f32 nearPlane, f32 farPlane)
+{
+    fogNear = nearPlane;
+    fogFar = farPlane;
+}
+
+void PS2GS::SetFogColor(ZunColor color)
+{
+    fogColor = color; // fog is not implemented on the GS backend yet (see README-PS2.md)
+}
+
+void PS2GS::ToggleVertexAttribute(u8 attr, bool enable)
+{
+    if (attr & VERTEX_ATTR_TEX_COORD)
+        useTexCoord = enable;
+    if (attr & VERTEX_ATTR_DIFFUSE)
+        useDiffuse = enable;
+}
+
+void PS2GS::SetAttributePointer(VertexAttributeArrays attr, std::size_t stride, void *ptr)
+{
+    switch (attr)
+    {
+    case VERTEX_ARRAY_POSITION:
+        vertexData = ptr;
+        vertexStride = stride;
+        break;
+    case VERTEX_ARRAY_TEX_COORD:
+        texCoordData = ptr;
+        texCoordStride = stride;
+        break;
+    case VERTEX_ARRAY_DIFFUSE:
+        diffuseData = ptr;
+        diffuseStride = stride;
+        break;
+    }
+}
+
+void PS2GS::SetColorOp(TextureOpComponent component, ColorOp op)
+{
+    if (component == COMPONENT_ALPHA)
+        return;
+    colorOp = op;
+}
+
+void PS2GS::SetTextureFactor(ZunColor factor)
+{
+    textureFactor = factor;
+}
+
+void PS2GS::SetTransformMatrix(TransformMatrix type, const ZunMatrix &matrix)
+{
+    switch (type)
+    {
+    case MATRIX_MODEL:
+        model = matrix;
+        break;
+    case MATRIX_VIEW:
+        view = matrix;
+        break;
+    case MATRIX_PROJECTION:
+        projection = matrix;
+        break;
+    case MATRIX_TEXTURE:
+        textureMatrix = matrix;
+        textureMatrixIsIdentity = IsIdentity(matrix);
+        break;
+    }
+}
+
+void PS2GS::SetTextureFilter()
+{
+    // bilinear filtering is always used
+}
+
+void PS2GS::GetViewport(u32 *out)
+{
+    for (int i = 0; i < 4; i++)
+        out[i] = (u32)viewport[i];
+}
+
+void PS2GS::GetDepthRange(f32 *depthRange)
+{
+    depthRange[0] = depthNear;
+    depthRange[1] = depthFar;
+}
+
+void PS2GS::SetViewport(i32 x, i32 y, i32 width, i32 height)
+{
+    viewport[0] = x;
+    viewport[1] = y;
+    viewport[2] = width;
+    viewport[3] = height;
+}
+
+void PS2GS::SetDepthRange(f32 nearPlane, f32 farPlane)
+{
+    depthNear = nearPlane;
+    depthFar = farPlane;
+}
+
+void PS2GS::Enable(Capabilities cap)
+{
+    if (cap == CAPS_DEPTH_TEST)
+        useDepthTest = true;
+    // CAPS_BLEND: blending is always enabled
+}
+
+void PS2GS::SetBlendMode(BlendMode mode)
+{
+    blendMode = mode;
+}
+
+void PS2GS::SetDepthMask(bool enable)
+{
+    depthMask = enable;
+}
+
+void PS2GS::SetDepthFunc(DepthFunc func)
+{
+    depthFunc = func;
+}
+
+void PS2GS::SetClearDepth(f32 depth)
+{
+    clearDepth = depth;
+}
+
+void PS2GS::SetClearColor(f32 r, f32 g, f32 b, f32 a)
+{
+    clearRGB[0] = (u8)(std::clamp(r, 0.0f, 1.0f) * 255.0f);
+    clearRGB[1] = (u8)(std::clamp(g, 0.0f, 1.0f) * 255.0f);
+    clearRGB[2] = (u8)(std::clamp(b, 0.0f, 1.0f) * 255.0f);
+}
+
+// ------------------------------------------------------------------------------------------------
+// GS register helpers
+// ------------------------------------------------------------------------------------------------
+
+void PS2GS::PushRegister(u64 data, u64 address)
+{
+    u64 *p = (u64 *)gsKit_heap_alloc(gs, 1, 16, GIF_AD);
+    *p++ = GIF_TAG_AD(1);
+    *p++ = GIF_AD;
+    *p++ = data;
+    *p++ = address;
+}
+
+void PS2GS::ApplyRenderState()
+{
+    // Never let the draw queue overflow: if it is nearly full, kick what we have so far to the GS.
+    {
+        GSQUEUE *q = gs->CurQueue;
+        if ((u8 *)q->pool_max[q->dbuf] - (u8 *)q->pool_cur < 64 * 1024)
+        {
+            gsKit_queue_exec(gs);
+        }
+    }
+
+    // Blending: Cd' = (Cs - Cd) * As + Cd   or   Cd' = Cs * As + Cd
+    if (blendMode == BLEND_INV_SRC_ALPHA)
+        gsKit_set_primalpha(gs, GS_SETREG_ALPHA(0, 1, 0, 1, 0), 0);
+    else
+        gsKit_set_primalpha(gs, GS_SETREG_ALPHA(0, 2, 0, 1, 0), 0);
+    gs->PrimAlphaEnable = GS_SETTING_ON;
+
+    // Alpha test (drops nearly transparent texels, including their Z writes) + depth test
+    gs->Test->ATE = 1;
+    gs->Test->ATST = 6; // GREATER
+    gs->Test->AREF = 5; // ~10/255, the same threshold as the software rasterizer
+    gs->Test->AFAIL = 0; // KEEP
+    gs->Test->ZTE = 1;
+    gs->Test->ZTST = (useDepthTest && depthFunc == DEPTH_FUNC_LEQUAL) ? 2 /*GEQUAL*/ : 1 /*ALWAYS*/;
+    gsKit_set_test(gs, 0);
+
+    // The GS Z buffer is inverted (0 = far), written only when depth test is on and the depth mask is set
+    const bool zwrite = useDepthTest && depthMask;
+    PushRegister(GS_SETREG_ZBUF(gs->ZBuffer / 8192, gs->PSMZ, zwrite ? 0 : 1), GS_ZBUF_1 + gs->PrimContext);
+
+    // The viewport becomes a scissor rectangle
+    int x0 = (int)(viewport[0] * scaleX);
+    int y0 = (int)(viewport[1] * scaleY);
+    int x1 = (int)((viewport[0] + viewport[2]) * scaleX) - 1;
+    int y1 = (int)((viewport[1] + viewport[3]) * scaleY) - 1;
+    x0 = std::clamp(x0, 0, (int)gs->Width - 1);
+    x1 = std::clamp(x1, x0, (int)gs->Width - 1);
+    y0 = std::clamp(y0, 0, (int)gs->Height - 1);
+    y1 = std::clamp(y1, y0, (int)gs->Height - 1);
+    gsKit_set_scissor(gs, GS_SETREG_SCISSOR(x0, x1, y0, y1));
+}
+
+void PS2GS::Clear(u32 clearBits)
+{
+    if (clearBits & CLEAR_COLOR_BUFFER)
+    {
+        // gsKit_clear() fills colour and writes Z = 0 (the far plane); make sure Z writes are enabled
+        gsKit_set_scissor(gs, GS_SCISSOR_RESET);
+        PushRegister(GS_SETREG_ZBUF(gs->ZBuffer / 8192, gs->PSMZ, 0), GS_ZBUF_1 + gs->PrimContext);
+        gs->Test->ATE = 0;
+        gsKit_clear(gs, GS_SETREG_RGBAQ(clearRGB[0] >> 1, clearRGB[1] >> 1, clearRGB[2] >> 1, 0x80, 0));
+    }
+    else if (clearBits & CLEAR_DEPTH_BUFFER)
+    {
+        // Depth only: draw a full screen sprite at Z = 0 with every colour channel masked out
+        const u64 fbp = gs->ScreenBuffer[gs->ActiveBuffer & 1] / 8192;
+        gsKit_set_scissor(gs, GS_SCISSOR_RESET);
+        PushRegister(GS_SETREG_FRAME(fbp, gs->Width / 64, gs->PSM, 0xFFFFFFFF), GS_FRAME_1 + gs->PrimContext);
+        PushRegister(GS_SETREG_ZBUF(gs->ZBuffer / 8192, gs->PSMZ, 0), GS_ZBUF_1 + gs->PrimContext);
+        gs->Test->ATE = 0;
+        gs->Test->ZTST = 1; // ALWAYS
+        gsKit_set_test(gs, 0);
+        gsKit_prim_sprite(gs, 0, 0, gs->Width, gs->Height, 0, GS_SETREG_RGBAQ(0, 0, 0, 0x80, 0));
+        PushRegister(GS_SETREG_FRAME(fbp, gs->Width / 64, gs->PSM, 0), GS_FRAME_1 + gs->PrimContext);
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// Textures
+// ------------------------------------------------------------------------------------------------
+
+void PS2GS::ReleaseTextureMemory(Tex *tex)
+{
+    if (tex->alive && gs)
+        gsKit_TexManager_free(gs, &tex->gs);
+    if (tex->gs.Mem)
+    {
+        free(tex->gs.Mem);
+        tex->gs.Mem = nullptr;
+    }
+    tex->alive = false;
+}
+
+GfxTextureHandle PS2GS::CreateTexture()
+{
+    u32 id;
+    if (!freeTextures.empty())
+    {
+        id = freeTextures.back();
+        freeTextures.pop_back();
+        textures[id] = Tex();
+    }
+    else
+    {
+        id = (u32)textures.size();
+        textures.emplace_back();
+    }
+    std::memset(&textures[id].gs, 0, sizeof(GSTEXTURE));
+    return {id};
+}
+
+void PS2GS::BindTexture(GfxTextureHandle handle)
+{
+    if (handle.id >= textures.size())
+        return;
+    boundTexture = &textures[handle.id];
+}
+
+void PS2GS::DeleteTexture(GfxTextureHandle handle)
+{
+    if (handle.id == 0 || handle.id >= textures.size())
+        return;
+    Tex *t = &textures[handle.id];
+    if (boundTexture == t)
+        boundTexture = nullptr;
+    ReleaseTextureMemory(t);
+    freeTextures.push_back(handle.id);
+}
+
+void PS2GS::ConvertAndStore(Tex *tex, i32 x, i32 y, i32 w, i32 h, PixelFormat fmt, PixelDataType type, const void *data)
+{
+    const i32 stride = (i32)tex->gs.Width;
+    const u8 *src = (const u8 *)data;
+
+    for (i32 row = 0; row < h; row++)
+    {
+        u32 *dst = tex->gs.Mem + (size_t)(y + row) * stride + x;
+        if (type == PIXEL_UNSIGNED_BYTE)
+        {
+            if (fmt == PIXEL_RGB)
+            {
+                const u8 *s = src + (size_t)row * w * 3;
+                for (i32 i = 0; i < w; i++, s += 3)
+                    dst[i] = PackGS(s[0], s[1], s[2], 255);
+            }
+            else
+            {
+                const u8 *s = src + (size_t)row * w * 4;
+                for (i32 i = 0; i < w; i++, s += 4)
+                    dst[i] = PackGS(s[0], s[1], s[2], s[3]);
+            }
+        }
+        else
+        {
+            const u16 *s = (const u16 *)src + (size_t)row * w;
+            for (i32 i = 0; i < w; i++)
+            {
+                const u32 p = s[i];
+                switch (type)
+                {
+                case PIXEL_UNSIGNED_SHORT_4_4_4_4:
+                    dst[i] = PackGS(Expand(p >> 12, 4), Expand((p >> 8) & 15, 4), Expand((p >> 4) & 15, 4),
+                                    Expand(p & 15, 4));
+                    break;
+                case PIXEL_UNSIGNED_SHORT_5_5_5_1:
+                    dst[i] = PackGS(Expand(p >> 11, 5), Expand((p >> 6) & 31, 5), Expand((p >> 1) & 31, 5),
+                                    Expand(p & 1, 1));
+                    break;
+                default: // 5_6_5
+                    dst[i] = PackGS(Expand(p >> 11, 5), Expand((p >> 5) & 63, 6), Expand(p & 31, 5), 255);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+void PS2GS::SetTextureImage(u32 width, u32 height, PixelFormat fmt, PixelDataType type, const void *data)
+{
+    Tex *tex = boundTexture;
+    if (tex == nullptr)
+        return;
+
+    ReleaseTextureMemory(tex);
+
+    const u32 w = std::max<u32>(width, kMinTexSize);
+    const u32 h = std::max<u32>(height, kMinTexSize);
+    const u32 bytes = gsKit_texture_size_ee(w, h, TH06_TEX_PSM);
+
+    std::memset(&tex->gs, 0, sizeof(GSTEXTURE));
+    tex->gs.Mem = (u32 *)memalign(128, bytes);
+    if (tex->gs.Mem == nullptr)
+    {
+        utils::DebugPrint2("PS2GS: out of memory for a %ux%u texture", width, height);
+        return;
+    }
+    std::memset(tex->gs.Mem, 0, bytes);
+    tex->gs.Width = w;
+    tex->gs.Height = h;
+    tex->gs.PSM = TH06_TEX_PSM;
+    tex->gs.Filter = GS_FILTER_LINEAR;
+    tex->alive = true;
+
+    if (data)
+        ConvertAndStore(tex, 0, 0, (i32)width, (i32)height, fmt, type, data);
+
+    SyncDCache(tex->gs.Mem, (u8 *)tex->gs.Mem + bytes);
+    gsKit_TexManager_invalidate(gs, &tex->gs);
+}
+
+void PS2GS::SetTextureSubImage(i32 xoffset, i32 yoffset, i32 width, i32 height, const void *data)
+{
+    Tex *tex = boundTexture;
+    if (tex == nullptr || !tex->alive || data == nullptr)
+        return;
+
+    ConvertAndStore(tex, xoffset, yoffset, width, height, PIXEL_RGB, PIXEL_UNSIGNED_BYTE, data);
+
+    SyncDCache(tex->gs.Mem, (u8 *)tex->gs.Mem + gsKit_texture_size_ee(tex->gs.Width, tex->gs.Height, TH06_TEX_PSM));
+    gsKit_TexManager_invalidate(gs, &tex->gs);
+}
+
+void PS2GS::ReadPixels(i32 x, i32 y, i32 width, i32 height, const void *pixels)
+{
+    // Reading the frame buffer back from the GS is not supported yet: return opaque black.
+    u8 *dst = (u8 *)pixels;
+    for (i32 i = 0; i < width * height; i++, dst += 4)
+    {
+        dst[0] = dst[1] = dst[2] = 0;
+        dst[3] = 255;
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// Drawing
+// ------------------------------------------------------------------------------------------------
+
+PS2GS::ClipVert PS2GS::MakeVertex(i32 index, bool textured, const ZunMatrix &mvp) const
+{
+    ClipVert o;
+
+    const ZunVec3 pos = *(const ZunVec3 *)((const u8 *)vertexData + vertexStride * index);
+    const ZunVec4 clip = mvp * ZunVec4(pos, 1.0f);
+    o.x = clip.x;
+    o.y = clip.y;
+    o.z = clip.z;
+    o.w = clip.w;
+
+    o.u = o.v = 0.0f;
+    if (textured)
+    {
+        const ZunVec2 uv = *(const ZunVec2 *)((const u8 *)texCoordData + texCoordStride * index);
+        if (textureMatrixIsIdentity)
+        {
+            o.u = uv.x;
+            o.v = uv.y;
+        }
+        else
+        {
+            const ZunVec4 t = textureMatrix * ZunVec4(ZunVec3(uv.x, uv.y, 1.0f), 1.0f);
+            o.u = t.x;
+            o.v = t.y;
+        }
+    }
+
+    // Reproduce the fixed function colour pipeline of the software backend on a per vertex basis
+    f32 d[4] = {255.0f, 255.0f, 255.0f, 255.0f};
+    if (useDiffuse && diffuseData)
+    {
+        const ColorData cd = *(const ColorData *)((const u8 *)diffuseData + diffuseStride * index);
+        d[0] = cd.r;
+        d[1] = cd.g;
+        d[2] = cd.b;
+        d[3] = cd.a;
+    }
+
+    f32 f[4]; // "argument 2" of the texture stage: the texture factor, or the diffuse colour without vertex buffers
+    if (noVertexBuffer)
+    {
+        std::memcpy(f, d, sizeof(f));
+    }
+    else
+    {
+        f[0] = ZunR(textureFactor);
+        f[1] = ZunG(textureFactor);
+        f[2] = ZunB(textureFactor);
+        f[3] = ZunA(textureFactor);
+    }
+
+    f32 c[4];
+    if (textured)
+    {
+        // GS: texel * vertex colour. REPLACE means the texel is used as is.
+        for (int i = 0; i < 4; i++)
+            c[i] = (colorOp == COLOR_OP_REPLACE) ? 255.0f : f[i];
+    }
+    else
+    {
+        // No texture: argument 1 is the diffuse colour itself
+        for (int i = 0; i < 4; i++)
+            c[i] = (colorOp == COLOR_OP_REPLACE) ? d[i] : d[i] * f[i] * (1.0f / 255.0f);
+    }
+    o.r = c[0];
+    o.g = c[1];
+    o.b = c[2];
+    o.a = c[3];
+    return o;
+}
+
+void PS2GS::EmitTriangle(const ClipVert &a, const ClipVert &b, const ClipVert &c, bool textured)
+{
+    const ClipVert *tri[3] = {&a, &b, &c};
+
+    for (int i = 0; i < 3; i++)
+    {
+        const ClipVert &v = *tri[i];
+        const f32 invW = 1.0f / v.w;
+        const f32 ndcX = v.x * invW;
+        const f32 ndcY = v.y * invW;
+        const f32 ndcZ = v.z * invW;
+
+        const f32 sx = (((ndcX + 1.0f) * 0.5f * viewport[2]) + viewport[0]) * scaleX - 0.5f;
+        const f32 sy = (((1.0f - (ndcY + 1.0f) * 0.5f) * viewport[3]) + viewport[1]) * scaleY - 0.5f;
+
+        f32 depth = (ndcZ * 0.5f + 0.5f) * (depthFar - depthNear) + depthNear;
+        depth = std::clamp(depth, 0.0f, 1.0f);
+        const int iz = (int)((1.0f - depth) * 65535.0f); // inverted: the GS test is GEQUAL
+
+        const u8 r = ToGS(v.r), g = ToGS(v.g), bl = ToGS(v.b), al = ToGS(v.a);
+
+        if (textured)
+        {
+            GSPRIMSTQPOINT p;
+            p.rgbaq = color_to_RGBAQ(r, g, bl, al, invW);
+            p.stq.st.s = v.u * invW;
+            p.stq.st.t = v.v * invW;
+            p.stq.tag = GS_ST;
+            p.xyz2 = vertex_to_XYZ2(gs, sx, sy, iz);
+            texBatch.push_back(p);
+        }
+        else
+        {
+            GSPRIMPOINT p;
+            p.rgbaq = color_to_RGBAQ(r, g, bl, al, 0.0f);
+            p.xyz2 = vertex_to_XYZ2(gs, sx, sy, iz);
+            flatBatch.push_back(p);
+        }
+    }
+
+    if ((textured ? texBatch.size() : flatBatch.size()) >= (size_t)kMaxBatchVerts)
+        FlushBatch(textured);
+}
+
+void PS2GS::ClipAndEmit(const ClipVert &a, const ClipVert &b, const ClipVert &c, bool textured)
+{
+    const u32 oa = OutCode(a.x, a.y, a.w), ob = OutCode(b.x, b.y, b.w), oc = OutCode(c.x, c.y, c.w);
+
+    if ((oa & ob & oc) != 0)
+        return; // entirely outside one plane
+    if ((oa | ob | oc) == 0)
+    {
+        EmitTriangle(a, b, c, textured);
+        return;
+    }
+
+    // Sutherland-Hodgman against the near plane and the 4 guard band planes
+    ClipVert bufA[12], bufB[12];
+    ClipVert *in = bufA, *out = bufB;
+    int inCount = 3;
+    in[0] = a;
+    in[1] = b;
+    in[2] = c;
+
+    for (int plane = 0; plane < 5 && inCount >= 3; plane++)
+    {
+        int outCount = 0;
+        for (int i = 0; i < inCount; i++)
+        {
+            const ClipVert &cur = in[i];
+            const ClipVert &nxt = in[(i + 1) % inCount];
+            const f32 dc = PlaneDist(plane, cur.x, cur.y, cur.w);
+            const f32 dn = PlaneDist(plane, nxt.x, nxt.y, nxt.w);
+
+            if (dc >= 0.0f)
+                out[outCount++] = cur;
+            if ((dc >= 0.0f) != (dn >= 0.0f))
+            {
+                const f32 t = dc / (dc - dn);
+                ClipVert &o = out[outCount++];
+                o.x = cur.x + (nxt.x - cur.x) * t;
+                o.y = cur.y + (nxt.y - cur.y) * t;
+                o.z = cur.z + (nxt.z - cur.z) * t;
+                o.w = cur.w + (nxt.w - cur.w) * t;
+                o.u = cur.u + (nxt.u - cur.u) * t;
+                o.v = cur.v + (nxt.v - cur.v) * t;
+                o.r = cur.r + (nxt.r - cur.r) * t;
+                o.g = cur.g + (nxt.g - cur.g) * t;
+                o.b = cur.b + (nxt.b - cur.b) * t;
+                o.a = cur.a + (nxt.a - cur.a) * t;
+            }
+        }
+        std::swap(in, out);
+        inCount = outCount;
+    }
+
+    for (int i = 1; i + 1 < inCount; i++)
+        EmitTriangle(in[0], in[i], in[i + 1], textured);
+}
+
+void PS2GS::FlushBatch(bool textured)
+{
+    const size_t count = textured ? texBatch.size() : flatBatch.size();
+    if (count == 0)
+        return;
+
+    ApplyRenderState();
+
+    if (textured)
+    {
+        boundTexture->gs.Filter = GS_FILTER_LINEAR;
+        gsKit_TexManager_bind(gs, &boundTexture->gs);
+        gsKit_prim_list_triangle_goraud_texture_stq_3d(gs, &boundTexture->gs, (int)count, texBatch.data());
+        texBatch.clear();
+    }
+    else
+    {
+        gsKit_prim_list_triangle_gouraud_3d(gs, (int)count, flatBatch.data());
+        flatBatch.clear();
+    }
+}
+
+void PS2GS::Draw(PrimitiveType type, i32 start, i32 count)
+{
+    if (count < 3 || vertexData == nullptr)
+        return;
+
+    const bool textured = useTexCoord && texCoordData && boundTexture && boundTexture->alive;
+    if (useTexCoord && !textured)
+        return; // nothing sensible to draw without a texture
+
+    const ZunMatrix mvp = projection * (view * model);
+
+    // Transform every vertex once (strips share vertices between up to 3 triangles)
+    clipVerts.resize(count);
+    for (i32 i = 0; i < count; i++)
+        clipVerts[i] = MakeVertex(start + i, textured, mvp);
+
+    if (type == PRIM_TRIANGLE_STRIP)
+    {
+        for (i32 i = 0; i + 2 < count; i++)
+            ClipAndEmit(clipVerts[i], clipVerts[i + 1], clipVerts[i + 2], textured);
+    }
+    else
+    {
+        for (i32 i = 0; i + 2 < count; i += 3)
+            ClipAndEmit(clipVerts[i], clipVerts[i + 1], clipVerts[i + 2], textured);
+    }
+
+    FlushBatch(textured);
+}
+
+void PS2GS::SwapBuffers()
+{
+    gsKit_queue_exec(gs);
+    gsKit_finish();
+    gsKit_sync_flip(gs);
+    gsKit_TexManager_nextFrame(gs);
+}
