diff --git a/src/Supervisor.cpp b/src/Supervisor.cpp
index 37e414e..a54f317 100644
--- a/src/Supervisor.cpp
+++ b/src/Supervisor.cpp
@@ -606,6 +606,52 @@ void Supervisor::ReleasePbg3(i32 pbg3FileIdx)
     this->pbg3Archives[pbg3FileIdx] = NULL;
 }
 
+#ifdef __PS2__
+// The original game ships files named like "紅魔郷IN.DAT". Many PS2 file systems (host:, USB, memory card)
+// cannot open non-ASCII names, so also try the ASCII names used by the English patch: KOUMAKYO_IN.DAT / .dat
+static bool LoadPbg3WithFallback(Pbg3Archive *archive, const char *filename)
+{
+    if (archive->Load(filename) != 0)
+    {
+        return true;
+    }
+    utils::DebugPrint2("PS2: could not open '%s'", filename);
+
+    const char *kanji = "\xE7\xB4\x85\xE9\xAD\x94\xE9\x83\xB7"; // UTF-8 of 紅魔郷
+    const size_t kanjiLen = std::strlen(kanji);
+    if (std::strncmp(filename, kanji, kanjiLen) != 0)
+    {
+        return false;
+    }
+
+    const char *suffix = filename + kanjiLen; // e.g. "IN.DAT"
+    char alt[64];
+    std::snprintf(alt, sizeof(alt), "KOUMAKYO_%s", suffix);
+    if (archive->Load(alt) != 0)
+    {
+        utils::DebugPrint2("PS2: opened '%s' instead", alt);
+        return true;
+    }
+    // try a lower case extension as well
+    size_t len = std::strlen(alt);
+    if (len > 4)
+    {
+        for (size_t i = len - 3; i < len; i++)
+        {
+            if (alt[i] >= 'A' && alt[i] <= 'Z')
+                alt[i] = alt[i] - 'A' + 'a';
+        }
+        if (archive->Load(alt) != 0)
+        {
+            utils::DebugPrint2("PS2: opened '%s' instead", alt);
+            return true;
+        }
+    }
+    utils::DebugPrint2("PS2: could not open '%s' either", alt);
+    return false;
+}
+#endif
+
 i32 Supervisor::LoadPbg3(i32 pbg3FileIdx, const char *filename)
 {
     if (this->pbg3Archives[pbg3FileIdx] == NULL || strcmp(filename, this->pbg3ArchiveNames[pbg3FileIdx]) != 0)
@@ -613,7 +659,11 @@ i32 Supervisor::LoadPbg3(i32 pbg3FileIdx, const char *filename)
         this->ReleasePbg3(pbg3FileIdx);
         this->pbg3Archives[pbg3FileIdx] = new Pbg3Archive();
         utils::DebugPrint("%s open ...\n", filename);
+#ifdef __PS2__
+        if (LoadPbg3WithFallback(this->pbg3Archives[pbg3FileIdx], filename))
+#else
         if (this->pbg3Archives[pbg3FileIdx]->Load(filename) != 0)
+#endif
         {
             std::strcpy(this->pbg3ArchiveNames[pbg3FileIdx], filename);
 
@@ -635,6 +685,10 @@ i32 Supervisor::LoadPbg3(i32 pbg3FileIdx, const char *filename)
             // manual nulling?
             this->pbg3Archives[pbg3FileIdx] = NULL;
             this->pbg3Archives[pbg3FileIdx] = NULL;
+#ifdef __PS2__
+            g_GameErrorContext.Fatal("error : cannot open data file %s\n", filename);
+            return 1;
+#endif
         }
     }
     return 0;
