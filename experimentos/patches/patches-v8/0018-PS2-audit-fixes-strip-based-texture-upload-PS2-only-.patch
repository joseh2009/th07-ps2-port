 void PS2GS::SwapBuffers()
 {
     static int frame = 0;
+#ifdef TH07_PS2_VERBOSE
     if (frame < 5)
         printf("PS2GS: SwapBuffers frame %d (queue used: %d bytes)\n", frame,
                (int)((u8 *)gs->CurQueue->pool_cur - (u8 *)gs->CurQueue->pool[gs->CurQueue->dbuf]));
+#endif
