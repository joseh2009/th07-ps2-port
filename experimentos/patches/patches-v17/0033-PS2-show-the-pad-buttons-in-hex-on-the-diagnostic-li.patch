From 54b3e39b85fe01307b1faff8edcc7912d5b47260 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 15:56:45 -0300
Subject: [PATCH 33/37] PS2: show the pad buttons in hex on the diagnostic line

The last field is now the buttons GetButtons() reports this frame
(0 = none), so it shows whether pad input reaches the game.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019yH2brr5GjCGyCE62bYyXR
---
 src/Ps2Pad.cpp     | 6 +++---
 src/Supervisor.cpp | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/Ps2Pad.cpp b/src/Ps2Pad.cpp
index eaf4b8f..bdd6e6f 100644
--- a/src/Ps2Pad.cpp
+++ b/src/Ps2Pad.cpp
@@ -15,9 +15,9 @@ static bool s_Ready = false;
 
 #define STICK_DEADZONE 48
 
-// Diagnostic shown next to the fps counter: last padGetState() value (6 = stable), or -1 if the pad was never opened.
+// Diagnostic shown next to the fps counter: the buttons GetButtons() reports this frame, in hex (0 = none).
 // The console log is not visible on hardware, so this is the only way to see it there.
-int g_Ps2PadState = -1;
+u32 g_Ps2PadHeld = 0;
 
 bool Ps2Pad::Init()
 {
@@ -54,7 +54,6 @@ u16 Ps2Pad::GetButtons()
     if (!s_Ready)
         return 0;
     int state = padGetState(0, 0);
-    g_Ps2PadState = state;
     if (state != PAD_STATE_STABLE && state != PAD_STATE_FINDCTP1)
         return 0;
 
@@ -63,6 +62,7 @@ u16 Ps2Pad::GetButtons()
         return 0;
 
     u16 held = ~pad.btns; // active low
+    g_Ps2PadHeld = held;
     u16 out = 0;
     if (held & PAD_UP)
         out |= TH_BUTTON_UP;
diff --git a/src/Supervisor.cpp b/src/Supervisor.cpp
index 1c4f606..98a63d7 100644
--- a/src/Supervisor.cpp
+++ b/src/Supervisor.cpp
@@ -41,7 +41,7 @@ char g_ReplayFpsBuffer[256];
 #ifdef __PS2__
 extern u64 g_Ps2GsMsTotal;
 extern u32 g_Ps2GsFrames;
-extern int g_Ps2PadState;
+extern u32 g_Ps2PadHeld;
 #endif
 char g_FpsCounterBuffer[256];
 u32 g_NumFramesSinceLastTime;
@@ -702,8 +702,8 @@ void Supervisor::DrawFpsCounter(i32 param_1)
 #ifdef __PS2__
                 // Diagnostic: fps, then the average ms per frame spent in SwapBuffers (GS) since the last update
                 // Short on purpose: the counter is drawn at the right edge of the screen, so longer text is cut off
-                sprintf(g_FpsCounterBuffer, "%.0f g%.0f s%d", (f64)fps,
-                        g_Ps2GsFrames ? (f64)g_Ps2GsMsTotal / (f64)g_Ps2GsFrames : 0.0, g_Ps2PadState);
+                sprintf(g_FpsCounterBuffer, "%.0f g%.0f %X", (f64)fps,
+                        g_Ps2GsFrames ? (f64)g_Ps2GsMsTotal / (f64)g_Ps2GsFrames : 0.0, g_Ps2PadHeld);
                 g_Ps2GsMsTotal = 0;
                 g_Ps2GsFrames = 0;
 #else
-- 
