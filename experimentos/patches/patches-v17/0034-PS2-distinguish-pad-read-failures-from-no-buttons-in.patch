From a29cf9426b151cca2dd4eba303dbf8cc48a5ff52 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 16:05:07 -0300
Subject: [PATCH 34/37] PS2: distinguish pad read failures from "no buttons" in
 the diagnostic

The diagnostic value is now 0x10000 when padRead returns no data,
0x2000x when the pad is not ready (x = state), and the button mask
otherwise. Before, a failed read and an idle pad both showed 0.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019yH2brr5GjCGyCE62bYyXR
---
 src/Ps2Pad.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/Ps2Pad.cpp b/src/Ps2Pad.cpp
index bdd6e6f..f961de0 100644
--- a/src/Ps2Pad.cpp
+++ b/src/Ps2Pad.cpp
@@ -55,11 +55,17 @@ u16 Ps2Pad::GetButtons()
         return 0;
     int state = padGetState(0, 0);
     if (state != PAD_STATE_STABLE && state != PAD_STATE_FINDCTP1)
+    {
+        g_Ps2PadHeld = 0x20000 | (u32)state; // diagnostic: pad not ready yet
         return 0;
+    }
 
     struct padButtonStatus pad;
     if (padRead(0, 0, &pad) == 0)
+    {
+        g_Ps2PadHeld = 0x10000; // diagnostic: padRead returned no data
         return 0;
+    }
 
     u16 held = ~pad.btns; // active low
     g_Ps2PadHeld = held;
