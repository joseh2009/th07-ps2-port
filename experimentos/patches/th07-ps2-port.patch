+    static char lines[40][100];
+    int count = 0;
+    char cur[100];
+    size_t ci = 0;
+    for (size_t i = 0; i <= s_LogLen; i++)
+    {
+        char ch = s_LogTail[i];
+        if (ch == '\n' || ch == 0)
+        {
+            cur[ci] = 0;
+            if (ci > 0)
+            {
+                strncpy(lines[count % 40], cur, 99);
+                lines[count % 40][99] = 0;
+                count++;
+            }
+            ci = 0;
+        }
+        else if (ch >= 32 && ch < 127 && ci < 96)
+            cur[ci++] = ch;
+        else if (ch < 0 && ci < 96)
+            cur[ci++] = '?';
+    }
+    int start = count > 24 ? count - 24 : 0;
