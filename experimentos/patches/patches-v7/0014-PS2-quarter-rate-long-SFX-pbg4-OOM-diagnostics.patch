From 0f1999bcc1d1a705548907c6f8085c348cb55321 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 20:59:09 -0300
Subject: [PATCH 14/26] PS2: quarter-rate long SFX, pbg4 OOM diagnostics

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_019yH2brr5GjCGyCE62bYyXR
---
 src/pbg4/Pbg4Archive.cpp | 7 +++++++
 src/ps2audio.cpp         | 5 +++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/pbg4/Pbg4Archive.cpp b/src/pbg4/Pbg4Archive.cpp
index b48067b..73b306a 100644
--- a/src/pbg4/Pbg4Archive.cpp
+++ b/src/pbg4/Pbg4Archive.cpp
@@ -1,3 +1,6 @@
+#ifdef __PS2__
+void Ps2HeapLog(const char *where);
+#endif
 #include "Pbg4Archive.hpp"
 
 #include <SDL2/SDL_stdinc.h>
@@ -93,6 +96,10 @@ u8 *Pbg4Archive::ReadDecompressEntry(const char *filename, u8 *buf)
     srcBuf = (u8 *)malloc(dwBytes);
     if (!srcBuf)
     {
+#ifdef __PS2__
+        Ps2HeapLog("pbg4 src");
+        Supervisor::DebugPrint("info : cannot allocate %u bytes for compressed %s\n", (unsigned)dwBytes, filename);
+#endif
         goto err;
     }
 
diff --git a/src/ps2audio.cpp b/src/ps2audio.cpp
index e8156ad..b1c853c 100644
--- a/src/ps2audio.cpp
+++ b/src/ps2audio.cpp
@@ -369,8 +369,9 @@ ma_result ma_decode_memory(const void *pData, size_t dataSize, ma_decoder_config
         AudioLog("audio: wav contains no samples\n");
         return MA_ERROR;
     }
-    // Effects are kept at half rate (22050 Hz) to fit the 32 MB of RAM; BufRead upsamples them while mixing.
-    const uint32_t div = kSfxRateDiv;
+    // Effects are kept at half rate (22050 Hz, quarter for long ones) to fit the 32 MB of RAM; BufRead upsamples them while mixing.
+    // Long effects (> 1 s) go to quarter rate: they are the bulk of the memory and mostly noise/low frequency anyway.
+    const uint32_t div = (srcFrames * 1000 / rate > 1000) ? kSfxRateDiv * 2 : kSfxRateDiv;
     const uint32_t storeRate = kRate / div;
     const uint64_t outFrames = srcFrames * storeRate / rate;
     const uint32_t outCh = channels > 1 ? 2 : 1;
-- 
