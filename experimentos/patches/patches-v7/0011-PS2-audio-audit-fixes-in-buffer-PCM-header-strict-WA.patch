-PcmInfo g_pcmInfo[128];
-int g_pcmCount = 0;
-void RegisterPcm(const void *p, uint32_t ch)
+static_assert(sizeof(PcmHeader) == 16, "keep the samples 16 byte aligned");
+
+int16_t *AllocPcm(ma_uint64 frames, uint32_t channels)
+{
+    const ma_uint64 bytes = frames * channels * sizeof(int16_t);
+    if (frames == 0 || bytes > (64ull << 20))
+        return nullptr;
+    PcmHeader *h = (PcmHeader *)std::malloc(sizeof(PcmHeader) + (size_t)bytes);
+    if (!h)
+        return nullptr;
+    h->magic = kPcmMagic;
+    h->channels = channels;
+    h->reserved[0] = h->reserved[1] = 0;
+    return (int16_t *)(h + 1);
+}
+
