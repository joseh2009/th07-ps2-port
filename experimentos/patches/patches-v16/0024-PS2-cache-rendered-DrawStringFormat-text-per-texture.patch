+    const u64 key = cacheable ? TextCacheKey(vm, textColor, outlineType, fontWidth, buf) : 0;
+    if (cacheable && this->textCache[texIdx].valid && this->textCache[texIdx].gen == this->textureWriteGen &&
+        this->textCache[texIdx].key == key)
+    {
+        vm->visible = 1;
+        return;
+    }
+
     this->DrawTextToSprite(vm->sprite->sourceFileIndex, vm->sprite->startPixelInclusive.x,
                            vm->sprite->startPixelInclusive.y, vm->sprite->textureWidth,
                            vm->sprite->textureHeight, fontWidth, vm->fontHeight, textColor,
@@ -2260,6 +2327,12 @@ void AnmManager::DrawStringFormat2(AnmVm *vm, u32 textColor, u32 outlineType, co
                            vm->fontHeight, textColor, outlineType, buf, vm->sprite->cols,
                            vm->sprite->rows);
 
+    if (cacheable)
+    {
+        this->textCache[texIdx].key = key;
+        this->textCache[texIdx].gen = this->textureWriteGen;
+        this->textCache[texIdx].valid = true;
+    }
     vm->visible = 1;
 }
 
