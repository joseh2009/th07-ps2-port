                                         strToPrint, this->textures[spriteDstIdx]);
@@ -2207,6 +2220,34 @@ void AnmManager::DrawVmTextFmt(AnmManager *manager, AnmVm *vm, u32 textColor, u3
     vm->visible = 1;
 }
 
+// FNV-1a over the inputs that decide what DrawStringFormat draws into its texture.
+static u64 TextCacheKey(const AnmVm *vm, u32 textColor, u32 outlineType, i32 fontWidth, const char *buf)
+{
+    u64 h = 1469598103934665603ULL;
+    auto mix = [&h](const void *p, size_t n) {
+        const u8 *b = (const u8 *)p;
+        for (size_t i = 0; i < n; i++)
+        {
+            h ^= b[i];
+            h *= 1099511628211ULL;
+        }
+    };
+    const AnmLoadedSprite *sp = vm->sprite;
+    mix(&sp->startPixelInclusive.x, sizeof(f32));
+    mix(&sp->startPixelInclusive.y, sizeof(f32));
+    mix(&sp->textureWidth, sizeof(f32));
+    mix(&sp->textureHeight, sizeof(f32));
+    mix(&sp->widthPx, sizeof(f32));
+    mix(&sp->cols, sizeof(f32));
+    mix(&sp->rows, sizeof(f32));
+    mix(&vm->fontHeight, sizeof(vm->fontHeight));
+    mix(&fontWidth, sizeof(fontWidth));
+    mix(&textColor, sizeof(textColor));
+    mix(&outlineType, sizeof(outlineType));
+    mix(buf, strlen(buf) + 1);
+    return h;
+}
+
 void AnmManager::DrawStringFormat(AnmVm *vm, u32 textColor, u32 outlineType, const char *text, ...)
 {
     i32 fontWidth;
@@ -2219,6 +2260,16 @@ void AnmManager::DrawStringFormat(AnmVm *vm, u32 textColor, u32 outlineType, con
     vsprintf(buf, text, args);
     va_end(args);
 
+    const i32 texIdx = vm->sprite->sourceFileIndex;
+    const bool cacheable = texIdx >= 0 && texIdx < MAX_TEXTURES;
+    const u64 key = cacheable ? TextCacheKey(vm, textColor, outlineType, fontWidth, buf) : 0;
+    if (cacheable && this->textCache[texIdx].valid && this->textCache[texIdx].gen == this->textureWriteGen &&
+        this->textCache[texIdx].key == key)
+    {
+        vm->visible = 1;
+        return;
+    }
+
     this->DrawTextToSprite(vm->sprite->sourceFileIndex, vm->sprite->startPixelInclusive.x,
                            vm->sprite->startPixelInclusive.y, vm->sprite->textureWidth,
                            vm->sprite->textureHeight, fontWidth, vm->fontHeight, textColor,
@@ -2232,6 +2283,12 @@ void AnmManager::DrawStringFormat(AnmVm *vm, u32 textColor, u32 outlineType, con
                            vm->fontHeight, textColor, outlineType, buf, vm->sprite->cols,
                            vm->sprite->rows);
 
+    if (cacheable)
+    {
+        this->textCache[texIdx].key = key;
+        this->textCache[texIdx].gen = this->textureWriteGen;
+        this->textCache[texIdx].valid = true;
+    }
     vm->visible = 1;
 }
 
@@ -2247,6 +2304,16 @@ void AnmManager::DrawStringFormat2(AnmVm *vm, u32 textColor, u32 outlineType, co
     vsprintf(buf, text, args);
     va_end(args);
 
+    const i32 texIdx = vm->sprite->sourceFileIndex;
