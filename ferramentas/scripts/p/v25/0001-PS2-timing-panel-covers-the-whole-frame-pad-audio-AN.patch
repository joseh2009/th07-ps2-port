+                            g_Ps2DiagDrawTop[k].ms);
+                else
+                    sprintf(s_Diag[16 + k], "  -");
+            }
             ZunVec3 diagPos;
             diagPos.z = 0.0f;
-            for (int i = 0; i < 6; i++)
